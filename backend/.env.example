# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# MongoDB connection string. Local default shown; use your Atlas URI to deploy.
DB_URL=mongodb://localhost:27017/aroundb

# Token signing secrets. Use two different values.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-your-own-secret
JWT_REFRESH_SECRET=replace-with-a-different-secret

# Origin allowed by CORS: scheme + host only. No path, no trailing slash.
CLIENT_URL=http://localhost:3000
